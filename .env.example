# Copy this file to .env, replace the two password placeholders, and keep .env local.
# The format is POSIX-shell compatible because scripts/run-local.sh sources this file.

# Application runtime
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
APP_LOG_LEVEL=DEBUG
ROOT_LOG_LEVEL=INFO

# MySQL connection used by a host-running application from step 5 onward.
# When the application also runs in Compose, DB_HOST must be the MySQL service name: mysql.
# If host port 3306 is already used by another MySQL, change DB_PORT and
# MYSQL_HOST_PORT together (for example 3307) so the app and Compose agree.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=commerce
DB_USERNAME=commerce_app
DB_PASSWORD=replace_with_app_password

# MySQL container setup used from step 4 onward. The host port must stay on 127.0.0.1.
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=replace_with_root_password
